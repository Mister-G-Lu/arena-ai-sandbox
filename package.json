{
  "name": "arena-ai-sandbox",
  "version": "1.0.0",
  "description": "A slow-burn action/storylet game in the Fallen London tradition, built in small PRs from this repo.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && node scripts/check-file-length.mjs",
    "check:file-length": "node scripts/check-file-length.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test:coverage",
    "check": "npm run quality && npm run build",
    "verify:pages": "npm run build && git diff --exit-code -- docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mister-G-Lu/arena-ai-sandbox.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Mister-G-Lu/arena-ai-sandbox/issues"
  },
  "homepage": "https://github.com/Mister-G-Lu/arena-ai-sandbox#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
